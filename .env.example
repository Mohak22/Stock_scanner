# Copy to .env locally and replace placeholders with real values.
# Never commit .env or put real credentials in this file.

# API safety
DEMO_MODE=true
FRONTEND_ORIGINS=http://localhost:5173

# Email (RECEIVER_EMAILS is a comma-separated list)
SENDER_EMAIL=sender@example.com
EMAIL_PASSWORD=replace-with-local-secret
RECEIVER_EMAILS=recipient1@example.com,recipient2@example.com

# Research data repository (use a least-privilege token)
STOCK_SCANNER_DATA_TOKEN=replace-with-data-repository-token
DATA_REPO_TOKEN=replace-with-github-actions-data-repository-token

# Research agent
RESEARCH_AGENT_PROVIDER=ollama
RESEARCH_AGENT_MODEL=qwen2.5:3b
OPENAI_API_KEY=replace-with-openai-api-key
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat

# Zerodha execution: paper mode and live trading disabled by default.
TRADING_EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
ZERODHA_API_KEY=replace-with-zerodha-api-key
ZERODHA_ACCESS_TOKEN=replace-with-zerodha-access-token
ZERODHA_TIMEOUT_SECONDS=10
